# Relative SQLite paths resolve from backend/prisma/schema.prisma,
# so this creates backend/prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Required. At least 32 characters; the server refuses to start with this placeholder.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-locally-generated-random-value"

# Optional; defaults to 4000. The frontend dev proxy expects 4000 unless
# you also set API_PROXY_TARGET in frontend/.env.
PORT=4000

# Optional comma-separated browser origins allowed to call the API cross-origin.
# Not needed for local development, which uses the Vite proxy.
# CORS_ORIGINS="https://app.example.com,https://www.example.com"
