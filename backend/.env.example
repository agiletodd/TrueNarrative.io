# Relative SQLite paths resolve from backend/prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Generate your own value; do not use this placeholder as a signing secret.
# Start with the guide's --env-file command so it is loaded before JWT imports.
JWT_SECRET="replace-with-a-locally-generated-random-value"

# Optional; server.js defaults to 4000.
PORT=4000
