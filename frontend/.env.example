# Optional. Leave VITE_API_URL unset in development: the Vite dev server proxies
# /api to the backend. Set it for a production build whose API lives on another
# origin (backend origin only; request paths already include /api).
# Vite exposes VITE_ variables to the browser; never put secrets here.
# VITE_API_URL=https://api.example.com

# Optional, development only: where the dev server proxies /api. Defaults to
# http://localhost:4000; change it if the backend runs on another PORT.
# API_PROXY_TARGET=http://localhost:4000
